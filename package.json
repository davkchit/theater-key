{
  "name": "teatr-kluch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node bot/scripts/publish-knowledge.mjs && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "cms:server": "decap-server",
    "knowledge": "node bot/scripts/publish-knowledge.mjs",
    "bot": "node --no-warnings bot/server/index.mjs",
    "bot:test": "node --no-warnings bot/server/test.mjs",
    "bot:eval": "node bot/scripts/eval.mjs --parser",
    "leads": "node --no-warnings bot/server/export-leads.mjs",
    "turns": "node --no-warnings bot/server/export-turns.mjs",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "motion": "^12.42.2",
    "nodemailer": "^10.0.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/marck-script": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "decap-server": "^3.10.0",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
