# Настройки бота. Скопируйте в .env.bot в корне проекта и заполните.
# .env.bot не попадает ни в git, ни в Docker-образы.

# ---- Telegram
TELEGRAM_BOT_TOKEN=
# чат администраторов: сюда приходят карточки заявок с кнопками статуса
ADMIN_CHAT_ID=

# ---- модель (любая с OpenAI-совместимым API, см. bot/core/llm.mjs)
# Яндекс, в проде:
#   LLM_BASE=https://llm.api.cloud.yandex.net/v1
#   LLM_AUTH=Api-Key
#   LLM_MODEL=gpt://<folder>/gpt-oss-120b/latest
#   YANDEX_FOLDER_ID=<folder>
# Groq, для тестов:
#   LLM_BASE=https://api.groq.com/openai/v1
#   LLM_AUTH=Bearer
#   LLM_MODEL=openai/gpt-oss-120b
LLM_BASE=
LLM_AUTH=
LLM_KEY=
LLM_MODEL=
# модель для разбора сообщений (может быть дешевле основной)
LLM_PARSER_MODEL=
# ключ только для проверочных прогонов (npm run bot:eval), чтобы они не тратили лимит бота
EVAL_LLM_KEY=

# ---- почта: заявки приходят письмом
# mail.ru: Настройки -> Безопасность -> Пароли для внешних приложений.
# Обычный пароль от ящика не подойдёт.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# куда слать заявки (по умолчанию на сам ящик SMTP_USER)
LEADS_EMAIL_TO=
# куда слать технические сигналы: модель не отвечает, кончились деньги,
# письмо о заявке не ушло (не чаще раза в час). Без адреса их никто не увидит
DEV_EMAIL_TO=

# ---- уведомление в Telegram: «пришла заявка, смотрите почту», без имён и
# телефонов. Бот из @BotFather; чаты (через запятую) тех, кто нажал у него «Старт»
TG_NOTIFY_TOKEN=
TG_NOTIFY_CHAT=

# ---- только для запуска без Docker, на своём компьютере
# ALLOWED_ORIGINS=http://localhost:5173
